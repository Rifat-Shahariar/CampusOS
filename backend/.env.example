# Backend (NestJS) — copy to .env and fill in. Never commit the real .env.

# Runtime
NODE_ENV=development
# Falls back to 3001 when unset/empty (or 0, which some environments use as "unset").
PORT=3001

# Browser origin(s) allowed by CORS. FRONTEND_URL is the primary origin;
# CORS_ORIGINS is an optional comma-separated list of extra origins.
# Wildcard origins are never used.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database — Supabase PostgreSQL.
#   DATABASE_URL: runtime connection used by the app (@prisma/adapter-pg / node-postgres).
#   DIRECT_URL:   direct connection used by Prisma Migrate / `prisma db seed`.
# The app reads DATABASE_URL first and falls back to DIRECT_URL.
#
# Use plain PostgreSQL URLs: node-postgres does not understand Prisma-only
# options such as `?pgbouncer=true` or `?schema=public`. If your provider hands
# you a pooled URL containing them, leave them out of DATABASE_URL here (the
# application strips those parameters defensively, but a clean URL is clearer).
DATABASE_URL=postgresql://postgres:<password>@<pooled-host>:6543/postgres
DIRECT_URL=postgresql://postgres:<password>@<direct-host>:5432/postgres

# Auth (JWT) — authentication configuration
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Supabase Storage (resource uploads) — reserved for the uploads step.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key
SUPABASE_STORAGE_BUCKET=campusos-resources
