// CampusOS database schema — PostgreSQL (Supabase).
//
// Managed with Prisma 7. The connection URL is NOT declared here; it lives in
// ../prisma7.config.ts (see Prisma 7's datasource config).
//
// Naming: Prisma models/fields use camelCase, the physical PostgreSQL objects
// use snake_case via @@map/@map — the table and column names are exactly the
// ones defined in the approved project plan.
//
// Deleting rows is deliberately restricted (see docs/architecture.md):
// participation history, uploaded files and published content must never be
// destroyed by a cascading delete. Records are deactivated (isActive /
// isPublished) instead of being removed.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  CLUB_ADMIN
  RESOURCE_ADMIN
  STUDENT
}

enum EventRegistrationStatus {
  REGISTERED
  CANCELLED
  ATTENDED
}

enum ResourceType {
  NOTE
  QUESTION_PAPER
  LAB_MANUAL
  NOTICE
  OTHER
}

enum NoticePriority {
  NORMAL
  IMPORTANT
  URGENT
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  /// Institution-issued student identifier. Nullable for staff accounts.
  studentId    String?  @unique @map("student_id")
  batch        String?
  section      String?
  departmentId String?  @map("department_id") @db.Uuid
  role         UserRole
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department           Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  clubAdminAssignments ClubAdminAssignment[] @relation("ClubAdminAssignmentUserName")
  assignmentsGranted   ClubAdminAssignment[] @relation("ClubAdminAssignmentAssignerName")
  eventsCreated        Event[]               @relation("EventCreator")
  eventRegistrations   EventRegistration[]
  attendanceChecks     EventAttendance[]     @relation("EventAttendanceCheckedInBy")
  clubPosts            ClubPost[]
  officialNotices      OfficialNotice[]
  resourcesUploaded    Resource[]

  @@index([departmentId])
  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Department
// ---------------------------------------------------------------------------

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users   User[]
  courses Course[]

  @@map("departments")
}

// ---------------------------------------------------------------------------
// Club
// ---------------------------------------------------------------------------

model Club {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  slug          String   @unique
  description   String
  logoUrl       String?  @map("logo_url")
  coverImageUrl String?  @map("cover_image_url")
  contactEmail  String?  @map("contact_email")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  adminAssignments ClubAdminAssignment[]
  events           Event[]
  posts            ClubPost[]

  @@map("clubs")
}

// ---------------------------------------------------------------------------
// ClubAdminAssignment — a club admin may manage multiple clubs
// ---------------------------------------------------------------------------

model ClubAdminAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  clubId     String   @map("club_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String   @map("assigned_by") @db.Uuid

  user           User @relation("ClubAdminAssignmentUserName", fields: [userId], references: [id], onDelete: Cascade)
  club           Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  assignedByUser User @relation("ClubAdminAssignmentAssignerName", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@unique([userId, clubId])
  @@index([clubId])
  @@map("club_admin_assignments")
}

// ---------------------------------------------------------------------------
// Event
// ---------------------------------------------------------------------------

model Event {
  id                     String    @id @default(uuid()) @db.Uuid
  clubId                 String    @map("club_id") @db.Uuid
  title                  String
  slug                   String    @unique
  description            String
  coverImageUrl          String?   @map("cover_image_url")
  eventType              String    @map("event_type")
  location               String
  startTime              DateTime  @map("start_time")
  endTime                DateTime  @map("end_time")
  registrationStart      DateTime? @map("registration_start")
  registrationEnd        DateTime? @map("registration_end")
  maxAttendees           Int?      @map("max_attendees")
  isRegistrationRequired Boolean   @default(false) @map("is_registration_required")
  isActive               Boolean   @default(true) @map("is_active")
  createdBy              String    @map("created_by") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  club          Club                @relation(fields: [clubId], references: [id], onDelete: Restrict)
  createdByUser User                @relation("EventCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  registrations EventRegistration[]

  @@index([clubId])
  @@index([startTime])
  @@index([eventType])
  @@index([isActive])
  @@map("events")
}

// ---------------------------------------------------------------------------
// EventRegistration
// ---------------------------------------------------------------------------

model EventRegistration {
  id               String                  @id @default(uuid()) @db.Uuid
  eventId          String                  @map("event_id") @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  registrationCode String                  @unique @map("registration_code")
  qrToken          String                  @unique @map("qr_token")
  status           EventRegistrationStatus @default(REGISTERED)
  registeredAt     DateTime                @default(now()) @map("registered_at")

  event      Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  attendance EventAttendance?

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@map("event_registrations")
}

// ---------------------------------------------------------------------------
// EventAttendance — one check-in record per registration
// ---------------------------------------------------------------------------

model EventAttendance {
  id             String   @id @default(uuid()) @db.Uuid
  registrationId String   @unique @map("registration_id") @db.Uuid
  checkedInBy    String   @map("checked_in_by") @db.Uuid
  checkedInAt    DateTime @default(now()) @map("checked_in_at")

  registration    EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  checkedInByUser User              @relation("EventAttendanceCheckedInBy", fields: [checkedInBy], references: [id], onDelete: Restrict)

  @@index([checkedInBy])
  @@map("event_attendance")
}

// ---------------------------------------------------------------------------
// ClubPost
// ---------------------------------------------------------------------------

model ClubPost {
  id            String    @id @default(uuid()) @db.Uuid
  clubId        String    @map("club_id") @db.Uuid
  title         String
  content       String
  coverImageUrl String?   @map("cover_image_url")
  createdBy     String    @map("created_by") @db.Uuid
  isPublished   Boolean   @default(false) @map("is_published")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  club          Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  createdByUser User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([clubId])
  @@map("club_posts")
}

// ---------------------------------------------------------------------------
// OfficialNotice
// ---------------------------------------------------------------------------

model OfficialNotice {
  id            String         @id @default(uuid()) @db.Uuid
  title         String
  content       String
  attachmentUrl String?        @map("attachment_url")
  priority      NoticePriority @default(NORMAL)
  isPublished   Boolean        @default(false) @map("is_published")
  createdBy     String         @map("created_by") @db.Uuid
  publishedAt   DateTime?      @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  createdByUser User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([priority])
  @@map("official_notices")
}

// ---------------------------------------------------------------------------
// Course
// ---------------------------------------------------------------------------

model Course {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  code         String   @unique
  name         String
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  resources  Resource[]

  @@index([departmentId])
  @@map("courses")
}

// ---------------------------------------------------------------------------
// Resource
//
// There is intentionally NO resource-admin assignment table: any RESOURCE_ADMIN
// may manage resources of any course. Batch/section are plain string fields.
// ---------------------------------------------------------------------------

model Resource {
  id           String       @id @default(uuid()) @db.Uuid
  courseId     String       @map("course_id") @db.Uuid
  title        String
  description  String?
  resourceType ResourceType @map("resource_type")
  fileName     String       @map("file_name")
  fileUrl      String       @map("file_url")
  fileSize     Int          @map("file_size")
  mimeType     String       @map("mime_type")
  batch        String?
  section      String?
  uploadedBy   String       @map("uploaded_by") @db.Uuid
  isPublished  Boolean      @default(false) @map("is_published")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  course         Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  uploadedByUser User   @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([courseId])
  @@index([resourceType])
  @@index([batch, section])
  @@index([uploadedBy])
  @@map("resources")
}
